# Copy to .env for local development. Never commit .env.
TOMTOM_API_KEY=
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Optional: shared cache (Upstash Redis rediss:// URL) for serverless hosting
REDIS_URL=
# Optional: comma-separated Open-Meteo models; the first is primary, the rest fill gaps
WEATHER_MODELS=ncep_nbm_conus,best_match
