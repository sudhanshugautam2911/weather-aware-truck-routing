# Copy to .env for local development. Never commit .env.
TOMTOM_API_KEY=
# Optional but recommended: WeatherAPI.com key (main weather source when set)
WEATHERAPI_KEY=
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Optional: shared cache (Upstash Redis rediss:// URL) for serverless hosting
REDIS_URL=
# Optional: weather sources in order (weatherapi, ncep_nbm_conus, best_match); later ones fill gaps
# WEATHER_MODELS=weatherapi,ncep_nbm_conus,best_match
